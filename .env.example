# Port the HTTP server listens on
PORT=3000

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/campus-lost-found

# Long random string used to sign the session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# development or production
NODE_ENV=development

# Maximum size of each uploaded image, in megabytes
MAX_UPLOAD_MB=5

# Public origin of the site, without a trailing slash. Used for canonical tags,
# sitemap.xml, robots.txt and llms.txt. In production, requests for any other
# host are redirected here with a 301.
SITE_URL=http://localhost:3000

# Address shown on the privacy policy page for data requests (optional)
SITE_CONTACT_EMAIL=
