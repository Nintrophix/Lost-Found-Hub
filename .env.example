# Port the HTTP server listens on
PORT=3000

# Postgres connection string. For Supabase: Project Settings > Database > Connection string,
# choose "Session pooler" (works over IPv4) and fill in your database password.
# Example: postgresql://postgres.abcdefghijkl:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/lostfound

# Maximum open database connections (keep it small on Supabase's free tier)
DATABASE_POOL_MAX=5

# Supabase Storage for uploaded photos (Project Settings > API). The service role key is
# a server-side secret: never expose it in browser code. Leave both empty to store photos
# in the local uploads/ folder instead.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=item-images

# Long random string used to sign the session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# development or production
NODE_ENV=development

# Maximum size of each uploaded image, in megabytes
MAX_UPLOAD_MB=5

# Public origin of the site, without a trailing slash. Used for canonical tags,
# sitemap.xml, robots.txt and llms.txt. In production, requests for any other
# host are redirected here with a 301.
SITE_URL=http://localhost:3000

# Address shown on the privacy policy page for data requests (optional)
SITE_CONTACT_EMAIL=
