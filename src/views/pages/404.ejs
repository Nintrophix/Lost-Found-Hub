<div class="container-narrow py-16">
  <h1 class="text-3xl font-extrabold">Page not found</h1>
  <p class="mt-3 text-muted">
    This page may have been moved, or the listing was deleted after its item was returned.
    Try searching for the item instead.
  </p>

  <form class="mt-6" action="/items" method="get" role="search">
    <label for="notfound-search" class="label">Search lost and found items</label>
    <div class="search-row">
      <input id="notfound-search" class="input" type="search" name="q" maxlength="200" autocomplete="off">
      <button class="btn btn-primary" type="submit"><%- icon('search') %>Search</button>
    </div>
  </form>

  <ul class="mt-8 space-y-2">
    <li><a class="font-semibold" href="/">Home page</a></li>
    <li><a class="font-semibold" href="/items?type=found">Found items waiting for owners</a></li>
    <li><a class="font-semibold" href="/items?type=lost">Lost items people are looking for</a></li>
    <li><a class="font-semibold" href="/items/new">Report an item</a></li>
  </ul>
</div>
