<%
  const me = currentUser.id;
  const othersRead = (m) => m.readBy.includes(other.id);
%>
<div class="container-narrow pt-4 pb-10">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h1 class="text-2xl font-extrabold">Chat with <%= other.firstName %></h1>
      <% if (item) { %>
        <p class="mt-1 text-gray-700">
          About <a class="prose-link" href="/items/<%= item._id %>"><%= item.title %></a>
          <span class="badge badge-<%= item.type %> ml-1"><%= item.type === 'lost' ? 'Lost' : 'Found' %></span>
          <span class="badge badge-<%= item.status %>"><%= statusLabels[item.status] %></span>
        </p>
      <% } else { %>
        <p class="mt-1 text-gray-700">The listing for this conversation was removed.</p>
      <% } %>
    </div>
    <% if (item && String(item.reporter) === me && item.status !== 'resolved') { %>
      <form action="/items/<%= item._id %>/resolve" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
        <button class="btn btn-secondary btn-sm" type="submit"><%- icon('check', 'icon-sm') %>Mark as returned</button>
      </form>
    <% } %>
  </div>

  <section class="panel mt-5 overflow-hidden chat-shell" id="chat"
           data-conversation-id="<%= conversationId %>"
           data-me="<%= me %>"
           data-other-id="<%= other.id %>"
           data-other-name="<%= other.firstName %>"
           aria-label="Conversation with <%= other.firstName %>">
    <div class="chat-log" id="chat-log" role="log" aria-live="polite" aria-relevant="additions" tabindex="0">
      <div class="text-center" id="load-older-wrap" <%= hasMore ? '' : 'hidden' %>>
        <button type="button" class="btn btn-secondary btn-sm" id="load-older">Load older messages</button>
      </div>
      <p class="text-center text-sm text-gray-600" id="chat-empty" <%= messages.length ? 'hidden' : '' %>>
        No messages yet. Suggest a public place on campus and a time to meet.
      </p>
      <% messages.forEach((m) => { const mine = m.sender.id === me; %>
        <div class="msg <%= mine ? 'msg-mine' : 'msg-theirs' %>" data-id="<%= m.id %>">
          <p class="msg-body"><%= m.body %></p>
          <p class="msg-meta">
            <span class="sr-only"><%= mine ? 'You' : m.sender.firstName %>, </span>
            <time datetime="<%= new Date(m.createdAt).toISOString() %>"><%= fmt.formatDateTime(m.createdAt) %></time>
            <% if (mine) { %><span class="receipt" data-receipt><%= othersRead(m) ? ' · Seen' : ' · Sent' %></span><% } %>
          </p>
        </div>
      <% }) %>
      <span id="latest"></span>
    </div>
    <p class="typing" id="typing" aria-live="polite"></p>
    <form class="chat-form" id="chat-form" action="/chat/<%= conversationId %>/messages" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
      <label class="sr-only" for="chat-input">Message to <%= other.firstName %></label>
      <textarea class="textarea" id="chat-input" name="body" rows="1" maxlength="<%= maxBody %>" required
                placeholder="Write a message"></textarea>
      <button class="btn btn-primary" type="submit" id="chat-send">Send</button>
    </form>
    <p class="field-error px-3 pb-2" id="chat-error" role="alert" hidden></p>
  </section>
  <p class="mt-3 text-sm text-gray-600">Meet in a public, staffed place such as a library desk or the student union. Never share passwords or payment details.</p>
</div>
