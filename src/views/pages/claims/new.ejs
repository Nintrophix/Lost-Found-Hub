<div class="container-narrow pt-4 pb-10">
  <h1 class="text-3xl font-extrabold">Claim this item</h1>
  <p class="mt-2 text-gray-700">
    You are claiming <a class="prose-link" href="/items/<%= item._id %>"><%= item.title %></a>,
    found at <%= item.location %> on <%= fmt.formatDate(item.dateLostOrFound) %>.
    The finder compares your answer with the item before approving.
  </p>

  <form class="panel panel-pad mt-6" action="/items/<%= item._id %>/claim" method="post" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
    <div class="field">
      <label class="label" for="message">How can you prove it is yours?</label>
      <textarea class="textarea" id="message" name="message" required minlength="20" maxlength="1000"
                aria-describedby="message-hint<%= errors.message ? ' message-error' : '' %>"
                <%- errors.message ? 'aria-invalid="true"' : '' %>><%= values.message %></textarea>
      <span class="hint" id="message-hint">
        Describe details that are not in the listing: a scratch, a sticker, the lock screen, what was inside,
        a name written somewhere. 20 to 1000 characters.
      </span>
      <%- include('../../partials/fieldError', { f: 'message', errors }) %>
    </div>
    <div class="flex flex-wrap gap-3">
      <button class="btn btn-found" type="submit">Send claim</button>
      <a class="btn btn-secondary" href="/items/<%= item._id %>">Cancel</a>
    </div>
  </form>
</div>
