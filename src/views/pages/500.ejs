<div class="container-narrow py-16">
  <h1 class="text-3xl font-extrabold"><%= title %></h1>
  <p class="mt-3 text-muted"><%= message %> <span class="text-subtle">(Error <%= status %>)</span></p>
  <% if (status >= 500) { %>
    <p class="mt-2 text-muted">The problem has been logged. Please try again in a minute.</p>
  <% } %>
  <% if (showDetails) { %>
    <pre class="mt-4 p-3 bg-sunken rounded text-sm overflow-auto">Development only: <%= detail %></pre>
  <% } %>

  <div class="mt-8 flex flex-wrap gap-3">
    <a class="btn btn-primary" href="/">Go to the home page</a>
    <a class="btn btn-secondary" href="/items">Browse items</a>
    <% if (status === 401 || status === 403) { %>
      <a class="btn btn-secondary" href="/login">Log in</a>
    <% } %>
  </div>
</div>
